{
  "name": "lwtv-underscores",
  "version": "7.2.6",
  "description": "LezWatch.TV Custom Theme.",
  "main": "index.js",
  "workspaces": [
    "./plugins/lwtv-plugin",
    "./plugins/lwtv-plugin/php/blocks"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "npm-run-all build:*",
    "build:composer": "composer update",
    "build:assets": "wp-scripts build --config _build_scripts/webpack.config.js --webpack-no-externals",
    "build:workspace": "npm run build:workspace --workspaces",
    "build:mover": "node ./_build_scripts/postbuild.js",
    "buildquick": "npm run build:assets && npm run build:mover",
    "docs:structure": "node _build_scripts/structure-docs.js",
    "docs:structure:check": "node _build_scripts/structure-docs.js --check",
    "symbolicons:prod": "LWTV_BRANCH=production node ./_build_scripts/symbolicons.js",
    "symbolicons:dev": "LWTV_BRANCH=development node ./_build_scripts/symbolicons.js",
    "create:local": "SVG_SPRITE_ENV=local npm run build",
    "create:staging": "SVG_SPRITE_ENV=staging npm run build",
    "lint": "npm-run-all lint:*",
    "prepare": "git config core.hooksPath .githooks",
    "lint:css": "wp-scripts lint-style '**/*.scss'",
    "lint:js": "npm-run-all lint:js:*",
    "lint:js:blocks": "wp-scripts lint-js 'plugins/lwtv-plugin/php/blocks/src/**/*.js'",
    "lint:js:theme": "wp-scripts lint-js 'inc/js/**/*.js'",
    "lint:js:plugin": "wp-scripts lint-js 'plugins/lwtv-plugin/assets/js/**/*.js'",
    "lint:php": "composer lint",
    "fix": "npm-run-all fix:*",
    "fix:css": "wp-scripts lint-style '**/*.scss' --fix ",
    "fix:js": "npm-run-all fix:js:*",
    "fix:js:blocks": "wp-scripts lint-js 'plugins/lwtv-plugin/php/blocks/src/**/*.js' --fix",
    "fix:js:theme": "wp-scripts lint-js 'inc/js/**/*.js' --fix",
    "fix:js:plugin": "wp-scripts lint-js 'plugins/lwtv-plugin/assets/js/**/*.js' --fix",
    "start": "npm-run-all start:*",
    "start:blocks": "npm run start --workspace=@lwtv/blocks",
    "test": "./vendor/bin/phpunit",
    "preinstall": "composer install",
    "updater": "composer update && npm update && wp-scripts packages-update && npm run updater:workspace --workspaces --if-present && npm run updater:relock",
    "updater:relock": "rm -f package-lock.json && npm install",
    "upgrader": "npx -y npm-check-updates -u --workspaces && npm run updater:relock",
    "clean": "npm-run-all clean:*",
    "clean:node": "rm -rf node_modules",
    "clean:vendor": "rm -rf vendor",
    "clean:workspace": "npm run clean:workspace --workspaces",
    "merge-to-develop": "currentBranch=$(git rev-parse --abbrev-ref HEAD) && git checkout development && git pull && git merge $currentBranch && git push origin development && git checkout $currentBranch",
    "merge-to-prod": "currentBranch=$(git rev-parse --abbrev-ref HEAD) && git checkout production && git pull && git merge $currentBranch && git push origin production && git checkout $currentBranch"
  },
  "author": "LezWatch.TV",
  "license": "GPL-2.0",
  "repository": "https://github.com/lezwatch/lwtv-underscores/",
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "simple-git": "^3",
    "tablesorter": "^2"
  },
  "devDependencies": {
    "@parcel/watcher": "^2",
    "@types/node": "^24",
    "@wordpress/scripts": "^35.0.0",
    "autoprefixer": "^10.6",
    "css-minimizer-webpack-plugin": "^8.0",
    "eslint-plugin-prettier": "^5.5",
    "lint-staged": "^17",
    "npm-run-all2": "^9",
    "postcss": "^8",
    "prettier": "npm:wp-prettier@3.9.6",
    "terser": "^5",
    "terser-webpack-plugin": "^5",
    "webpack": "^5"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "markdownlint-cli": "^0.49.1",
    "prettier": "npm:wp-prettier@3.9.6",
    "sockjs": {
      "uuid": ">=11.1.1"
    }
  },
  "lint-staged": {
    "*.php": "composer lint",
    "plugins/lwtv-plugin/php/blocks/src/**/*.js": "wp-scripts lint-js",
    "inc/js/**/*.js": "wp-scripts lint-js",
    "plugins/lwtv-plugin/assets/js/**/*.js": "wp-scripts lint-js",
    "**/*.scss": "wp-scripts lint-style"
  },
  "browserslist": [
    "last 2 versions",
    ">1%",
    "not dead"
  ]
}
